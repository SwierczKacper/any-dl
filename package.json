{
  "name": "kick-vod",
  "version": "1.9.0",
  "description": "Download Kick.com VODs and clips to MP4 in full quality (up to 1080p60). Fast CLI, no required dependencies, handles Kick's new UUIDv7 links.",
  "type": "module",
  "license": "MIT",
  "author": "Świercz Kacper (https://swierczkacper.pl)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwierczKacper/kick-vod.git"
  },
  "bugs": {
    "url": "https://github.com/SwierczKacper/kick-vod/issues"
  },
  "homepage": "https://github.com/SwierczKacper/kick-vod#readme",
  "bin": {
    "kick-vod": "bin/kick-vod.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "kick",
    "kick.com",
    "kick-vod",
    "vod",
    "vod-downloader",
    "downloader",
    "video-downloader",
    "clips",
    "stream",
    "streaming",
    "hls",
    "m3u8",
    "ffmpeg",
    "cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bin/kick-vod.js",
    "test": "node --test",
    "smoke": "node scripts/live-smoke.mjs"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  }
